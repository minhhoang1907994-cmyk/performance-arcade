# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env — đã nằm trong .gitignore.

# Postgres. Dùng devlab_dev khi phát triển; chỉ trỏ vào devlab_prod khi deploy thật.
DATABASE_URL=postgres://postgres:dev@localhost:55432/devlab_dev

# Bí mật ký access token. Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Admin đầu tiên, tạo bởi migration. Không có endpoint HTTP nào tạo admin (spec 4.2).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Bật chế độ chơi khách (BR-16). Tắt thì mọi lượt chơi đều phải đăng nhập.
ALLOW_ANONYMOUS_PLAY=true

PORT=3000
NODE_ENV=development
