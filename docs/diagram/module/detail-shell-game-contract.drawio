        <mxCell id="note1" value="Shell owns state.&#10;A game never touches localStorage&#10;and never writes DOM outside mount." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="120" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="api.shuffle is mandatory.&#10;Unshuffled data puts the good&#10;answer first every time." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="240" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="showResult clamps score to 0-100&#10;before recordPlay (js/app.js:238).&#10;Every localStorage call is try/catch." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="360" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note4" value="Script order in index.html is fixed:&#10;data/*.js, then js/games/*.js,&#10;then js/app.js." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
